rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Cover images: anyone can view (public site displays them);
    // only signed-in admins can upload/replace/delete.
    match /covers/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024      // 8 MB cap
        && request.resource.contentType.matches('image/.*');
    }
  }
}
